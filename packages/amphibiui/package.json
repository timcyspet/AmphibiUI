    "@lexical/selection": "^0.52.0",
    "chart.js": "^4.5.1",
    "chartjs-chart-geo": "4.3.6",
    "lexical": "^0.52.0",
    "react-chartjs-2": "^5.3.1",
    "react-grid-layout": "2.3.0",
